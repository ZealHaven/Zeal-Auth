# Database
DATABASE_URL=postgres://auth:auth@localhost:5435/auth?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6380/0

# Server
SERVER_PORT=8080
COOKIE_DOMAIN=localhost
# prod: COOKIE_DOMAIN=auth.yourdomain.com
# dev | prod — prod refuses to boot with missing/weak secrets below
APP_ENV=dev

# Admin API (POST /admin/clients) — X-Admin-Token header; unset = admin API disabled
ADMIN_TOKEN=

# OAuth2 global secret — >=32 random bytes; REQUIRED in prod
FOSITE_GLOBAL_SECRET=

# Email — log (dev default, prints to stdout) | smtp
EMAIL_DRIVER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Zeal Auth <no-reply@yourdomain.com>
# Absolute base URL used in verification/reset links (default https://$COOKIE_DOMAIN)
PUBLIC_URL=http://localhost:8080

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/oauth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8080/oauth/github/callback

# JWT Signing Keys
# KEY_ENCRYPTION_KEY: exactly 64 hex chars (32 bytes), e.g. `openssl rand -hex 32`
KEY_ENCRYPTION_KEY=
JWT_KID=key-1

# Key rotation (spec 4.6) — Go duration; 0 disables (dev default)
KEY_ROTATION_INTERVAL=0
KEY_RETIRE_WINDOW=168h

# Dynamic Client Registration (spec 5.15) — opt-in; unset = /register disabled
DCR_SOFTWARE_STATEMENT_SECRET=
# Comma-separated developer identities allowed to register (empty = anyone with a valid statement)
DCR_DEVELOPER_ALLOWLIST=
